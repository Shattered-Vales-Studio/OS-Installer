# =============================================================================
# Shattered Vales OS Studio edition - unattended installer kickstart
#
# WARNING: This erases the selected internal disk without asking.
# Values written as ${SV_*} are filled in by build-iso.sh from installer.env
# (personal values, never committed) and the command line (image, channel).
# =============================================================================

# -----------------------------------------------------------------------------
# Hardware detection. Runs before the installer reads the rest of this file
# and writes small include files that pick the image, disk and hostname.
# -----------------------------------------------------------------------------
%pre --interpreter=/usr/bin/bash --erroronfail --log=/tmp/sv-pre.log
set -euo pipefail

REGISTRY="${SV_IMAGE_REGISTRY}"
NAME="${SV_IMAGE_NAME}"
TAG="${SV_IMAGE_TAG}"
# Set only on offline ISOs, which carry one image in the installer's own
# container storage instead of downloading it.
OFFLINE_IMAGE="${SV_OFFLINE_IMAGE}"
FORCED_DISK="${SV_TARGET_DISK}"
HOST_PREFIX="${SV_HOSTNAME_PREFIX}"

# Choose the NVIDIA image when any display-class device is from vendor 10de.
# An offline ISO has exactly one image; if it does not match the graphics
# card, the installed system's GPU check offers the right one later.
if [[ -n "${OFFLINE_IMAGE}" ]]; then
    IMAGE="${OFFLINE_IMAGE}"
elif lspci -n | awk '$2 ~ /^03/ && $3 ~ /^10de:/ {f=1} END {exit !f}'; then
    IMAGE="${REGISTRY}/${NAME}-nvidia:${TAG}"
else
    IMAGE="${REGISTRY}/${NAME}:${TAG}"
fi

# Pick the target disk: forced value, else the largest internal NVMe, else the
# largest internal non-USB disk. The USB stick and virtual devices are skipped.
# TRAN is listed last because it is empty for virtual disks, which would
# otherwise shift the columns.
if [[ -n "${FORCED_DISK}" ]]; then
    DISK="${FORCED_DISK}"
else
    CANDIDATES="$(lsblk -dnbo NAME,TYPE,RM,SIZE,TRAN \
        | awk '$2=="disk" && $3==0 && $5!="usb" && $1 !~ /^(zram|loop|sr|fd)/')"
    DISK="$(awk '$5=="nvme"' <<<"${CANDIDATES}" | sort -k4,4nr | awk 'NR==1{print $1}')"
    [[ -n "${DISK}" ]] || DISK="$(sort -k4,4nr <<<"${CANDIDATES}" | awk 'NR==1{print $1}')"
fi
[[ -n "${DISK}" ]] || { echo "No internal disk found" >&2; exit 1; }

# Hostname from the hardware serial so machines are identifiable on the
# network and in asset lists; falls back to the first network MAC.
SERIAL="$(tr -cd '[:alnum:]' < /sys/class/dmi/id/product_serial 2>/dev/null | tr '[:upper:]' '[:lower:]')"
if [[ -z "${SERIAL}" || "${SERIAL}" == "tobefilledbyoem" || "${SERIAL}" == "defaultstring" ]]; then
    SERIAL="$(cat /sys/class/net/e*/address 2>/dev/null | head -n1 | tr -d ':')"
fi
HOSTNAME="${HOST_PREFIX}-${SERIAL: -8}"

# Offline ISOs install the embedded copy and record the registry image as
# the one to update from; network ISOs download it during the install.
if [[ -n "${OFFLINE_IMAGE}" ]]; then
    echo "bootc --source-imgref containers-storage:${IMAGE} --target-imgref ${IMAGE}" > /tmp/sv-source.ks
else
    echo "ostreecontainer --url=${IMAGE} --transport=registry --no-signature-verification" > /tmp/sv-source.ks
fi

cat > /tmp/sv-disk.ks <<KS
ignoredisk --only-use=${DISK}
zerombr
clearpart --all --initlabel --drives=${DISK} --disklabel=gpt
bootloader --boot-drive=${DISK}
KS

cat > /tmp/sv-host.ks <<KS
network --hostname=${HOSTNAME}
KS

# After install, move to the signed image so every later update is verified
# against the organization's cosign key. Written with printf because
# anaconda reads any line starting with %post or %end as a section marker,
# even inside a heredoc in this %pre script.
{
    printf '%%%s\n' 'post --erroronfail --log=/root/sv-post-switch.log'
    printf '%s\n' "bootc switch --mutate-in-place --enforce-container-sigpolicy --transport registry ${IMAGE}"
    printf '%%%s\n' 'end'
} > /tmp/sv-post.ks

echo "Image: ${IMAGE}  Disk: ${DISK}  Host: ${HOSTNAME}"
%end

# -----------------------------------------------------------------------------
# Installation settings
# -----------------------------------------------------------------------------
text
# A text-mode install otherwise sets the installed system to boot to a
# console (multi-user.target) instead of the GNOME login screen.
xconfig --startxonboot
reboot --eject
lang ${SV_LANG}
keyboard --vckeymap=${SV_KEYBOARD} --xlayouts='${SV_KEYBOARD}'
timezone ${SV_TIMEZONE} --utc
network --bootproto=dhcp --device=link --activate --onboot=on
%include /tmp/sv-host.ks

%include /tmp/sv-disk.ks
autopart --type=btrfs --noswap

%include /tmp/sv-source.ks

rootpw --lock
user --name=${SV_ADMIN_USER} --gecos="${SV_ADMIN_GECOS}" --groups=wheel --iscrypted --password=${SV_ADMIN_PASSWORD_HASH}
sshkey --username=${SV_ADMIN_USER} "${SV_ADMIN_SSH_PUBKEY}"

%include /tmp/sv-post.ks

# -----------------------------------------------------------------------------
# The IT account must not become Homebrew's owner: that belongs to the first
# developer who logs in (see the OS image's shatteredvales-homebrew.conf).
# -----------------------------------------------------------------------------
%post --erroronfail --log=/root/sv-post-homebrew.log
install -d -m 0755 /etc/shatteredvales
echo "${SV_ADMIN_USER}" >> /etc/shatteredvales/homebrew-skip-users
%end

# =============================================================================
# Shattered Vales OS Home Edition - guided installer kickstart
#
# Only the operating system image is preset. The installer's own screens ask
# for the language, keyboard, Wi-Fi and which disk to use, and no accounts
# are created here: on first boot the computer walks the family through
# creating their accounts. ${SV_*} values are filled in by build-iso.sh.
# =============================================================================

# -----------------------------------------------------------------------------
# Hardware detection: picks the NVIDIA or standard Home image.
# -----------------------------------------------------------------------------
%pre --interpreter=/usr/bin/bash --erroronfail --log=/tmp/sv-pre.log
set -euo pipefail

REGISTRY="${SV_IMAGE_REGISTRY}"
NAME="${SV_IMAGE_NAME}"
TAG="${SV_IMAGE_TAG}"
# Set only on offline ISOs, which carry one image in the installer's own
# container storage instead of downloading it.
OFFLINE_IMAGE="${SV_OFFLINE_IMAGE}"

# Choose the NVIDIA image when any display-class device is from vendor 10de.
# An offline ISO has exactly one image; if it does not match the graphics
# card, the installed system's GPU check offers the right one later.
if [[ -n "${OFFLINE_IMAGE}" ]]; then
    IMAGE="${OFFLINE_IMAGE}"
elif lspci -n | awk '$2 ~ /^03/ && $3 ~ /^10de:/ {f=1} END {exit !f}'; then
    IMAGE="${REGISTRY}/${NAME}-nvidia:${TAG}"
else
    IMAGE="${REGISTRY}/${NAME}:${TAG}"
fi

# Offline ISOs install the embedded copy and record the registry image as
# the one to update from; network ISOs download it during the install.
if [[ -n "${OFFLINE_IMAGE}" ]]; then
    echo "bootc --source-imgref containers-storage:${IMAGE} --target-imgref ${IMAGE}" > /tmp/sv-source.ks
else
    echo "ostreecontainer --url=${IMAGE} --transport=registry --no-signature-verification" > /tmp/sv-source.ks
fi

# After install, move to the signed image so every later update is verified
# against the organization's cosign key. Written with printf because
# anaconda reads any line starting with %post or %end as a section marker,
# even inside a heredoc in this %pre script.
{
    printf '%%%s\n' 'post --erroronfail --log=/root/sv-post-switch.log'
    printf '%s\n' "bootc switch --mutate-in-place --enforce-container-sigpolicy --transport registry ${IMAGE}"
    printf '%%%s\n' 'end'
} > /tmp/sv-post.ks

echo "Image: ${IMAGE}"
%end

# -----------------------------------------------------------------------------
# Installation settings
# -----------------------------------------------------------------------------
graphical
# Boot the installed system to the GNOME login screen (first-boot account
# setup) rather than a console, whatever mode the installer ran in.
xconfig --startxonboot
reboot --eject
autopart --type=btrfs --noswap
%include /tmp/sv-source.ks

# No root password; the first account created on first boot is an
# administrator.
rootpw --lock

%include /tmp/sv-post.ks

# =============================================================================
# Shattered Vales OS - guided installer kickstart (Studio and Home editions)
#
# Only the operating system image is preset; nothing ties an installer to a
# particular site or organization. The installer's own screens ask for the
# language, keyboard, network (and computer name), which disk to use, and
# the first user account, which is made an administrator. If that screen is
# skipped, GNOME's first-boot setup asks instead (Home Edition then
# continues into Family Setup). ${SV_*} values are filled in by build-iso.sh;
# the edition only changes SV_IMAGE_NAME.
# =============================================================================

# -----------------------------------------------------------------------------
# Hardware detection: picks the NVIDIA or standard image of the edition.
# -----------------------------------------------------------------------------
%pre --interpreter=/usr/bin/bash --erroronfail --log=/tmp/sv-pre.log
set -euo pipefail

REGISTRY="${SV_IMAGE_REGISTRY}"
NAME="${SV_IMAGE_NAME}"
TAG="${SV_IMAGE_TAG}"
# Set only on offline ISOs, which carry one image in the installer's own
# container storage instead of downloading it.
OFFLINE_IMAGE="${SV_OFFLINE_IMAGE}"

# Choose the NVIDIA image when any display-class device is from vendor 10de.
# An offline ISO has exactly one image; if it does not match the graphics
# card, the installed system's GPU check offers the right one later.
if [[ -n "${OFFLINE_IMAGE}" ]]; then
    IMAGE="${OFFLINE_IMAGE}"
elif lspci -n | awk '$2 ~ /^03/ && $3 ~ /^10de:/ {f=1} END {exit !f}'; then
    IMAGE="${REGISTRY}/${NAME}-nvidia:${TAG}"
else
    IMAGE="${REGISTRY}/${NAME}:${TAG}"
fi

# Offline ISOs install the copy in the installer's own container storage;
# network ISOs download it during the install. Both are then pointed at the
# signed registry image by %post below. Offline uses ostreecontainer rather
# than Anaconda's bootc source, which always demands a network connection
# and blocked offline installs at "Begin Installation".
if [[ -n "${OFFLINE_IMAGE}" ]]; then
    echo "ostreecontainer --url=${IMAGE} --transport=containers-storage --no-signature-verification" > /tmp/sv-source.ks
else
    echo "ostreecontainer --url=${IMAGE} --transport=registry --no-signature-verification" > /tmp/sv-source.ks
fi

# After install, move to the signed image so every later update is verified
# against the organization's cosign key. Written with printf because
# anaconda reads any line starting with %post or %end as a section marker,
# even inside a heredoc in this %pre script.
{
    printf '%%%s\n' 'post --erroronfail --log=/root/sv-post-switch.log'
    printf '%s\n' "bootc switch --mutate-in-place --enforce-container-sigpolicy --transport registry ${IMAGE}"
    printf '%%%s\n' 'end'
} > /tmp/sv-post.ks

echo "Image: ${IMAGE}"
%end

# -----------------------------------------------------------------------------
# Installation settings
# -----------------------------------------------------------------------------
graphical
# Boot the installed system to the GNOME login screen rather than a console,
# whatever mode the installer ran in.
xconfig --startxonboot
reboot --eject
%include /tmp/sv-source.ks

# Disk and partitioning are deliberately not set here, so the installer's
# Installation Destination screen always asks which disk to use (Fedora's
# automatic layout is Btrfs). No root password: administration goes through
# the administrator account created on the User Creation screen or at first
# boot.
rootpw --lock

# -----------------------------------------------------------------------------
# Image staging space: the image is unpacked through a folder on the target
# disk instead of the installer's own /var/tmp.
# -----------------------------------------------------------------------------
# ostree writes each image layer in full to /var/tmp before importing it. On
# an installer stick /var/tmp is part of the live system's small root
# filesystem (about 1.6 GB), so any layer bigger than that fails the install
# with "no space left on device", whatever the machine's RAM. %pre-install
# runs after the chosen disk is formatted and mounted at /mnt/sysimage (the
# physical root Anaconda deploys into) and before the image is deployed.
%pre-install --interpreter=/usr/bin/bash --erroronfail --log=/tmp/sv-pre-install.log
set -euo pipefail
staging=/mnt/sysimage/.sv-install-tmp
mkdir -p "${staging}"
chmod 1777 "${staging}"
mount --bind "${staging}" /var/tmp
echo "Staging image layers in ${staging}"
%end

%include /tmp/sv-post.ks

# Releases the staging folder before Anaconda unmounts the disk (a bind mount
# still in place would keep it busy) and deletes it, so the layers do not
# stay behind on the installed disk.
%post --nochroot --interpreter=/usr/bin/bash --log=/tmp/sv-post-cleanup.log
set -euo pipefail
staging=/mnt/sysimage/.sv-install-tmp
if mountpoint -q /var/tmp; then
    umount /var/tmp
fi
rm -rf "${staging}"
%end

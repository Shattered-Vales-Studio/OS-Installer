# Studio edition only. Copy to installer.env (git-ignored) on the machine that
# builds the USB, fill in, and keep it there. Anyone holding a built Studio USB
# stick can read these values, so treat the stick like a key.
# Home edition builds ignore this file: families create their own accounts on
# first boot.

SV_LANG="en_US.UTF-8"
SV_KEYBOARD="us"
SV_TIMEZONE="America/Los_Angeles"

# Leave empty for automatic selection (largest internal NVMe, else largest disk).
SV_TARGET_DISK=""
SV_HOSTNAME_PREFIX="sv"

# IT administrator created on every Studio install.
SV_ADMIN_USER="svadmin"
SV_ADMIN_GECOS="IT Administrator"
# Generate with: openssl passwd -6
SV_ADMIN_PASSWORD_HASH='$6$REPLACE_ME'
SV_ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... admin@example.com"
